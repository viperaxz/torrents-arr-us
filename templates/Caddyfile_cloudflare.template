{
    storage file_system {
        root "{$CADDY_DATA_DIR}"
    }
}

# Caddyfile — Cloudflare subdomain mode
# Each app gets its own subdomain: app.domain.com
# TLS_BLOCK is replaced by the installer with either:
#   tls internal                    (testing — Caddy local CA)
#   tls {$TLS_EMAIL}               (production — Let's Encrypt HTTP-01)

# Dashboard on root domain (static HTML)
{$DOMAIN} {
    {$TLS_BLOCK}
    log {
        output file "{$INSTALL_DIR}/logs/caddy-access.log" {
            roll_size 10mb
            roll_keep 3
        }
        format json
    }
    basic_auth {
        {$ADMIN_USER} {$ADMIN_HASH_BCRYPT}
    }
    root * "{$INSTALL_DIR}/dashboard"
    file_server
}

# Jellyfin
jellyfin.{$DOMAIN} {
    {$TLS_BLOCK}
    log {
        output file "{$INSTALL_DIR}/logs/caddy-access.log" {
            roll_size 10mb
            roll_keep 3
        }
        format json
    }
    reverse_proxy 127.0.0.1:{$JELLYFIN_PORT} {
        header_up X-Real-IP {remote_host}
        header_down -X-Frame-Options
    }
}

