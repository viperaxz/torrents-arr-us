{
    storage file_system {
        root "{$CADDY_DATA_DIR}"
    }
}

# Caddyfile — DuckDNS path-based mode
# Single host: domain.duckdns.org, all apps served under paths
# Each app must have UrlBase/BaseUrl configured to match its path prefix.
# TLS_BLOCK is replaced by the installer with either:
#   tls internal                    (testing — Caddy local CA)
#   tls {$TLS_EMAIL}               (production — Let's Encrypt HTTP-01)

{$DUCKDNS_HOST} {
    {$TLS_BLOCK}

    log {
        output file "{$INSTALL_DIR}/logs/caddy-access.log" {
            roll_size 10mb
            roll_keep 3
        }
        format json
    }

    # -- *Arr apps (UrlBase set on each app) --

    handle /sonarr* {
        reverse_proxy 127.0.0.1:{$SONARR_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /radarr* {
        reverse_proxy 127.0.0.1:{$RADARR_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /prowlarr* {
        reverse_proxy 127.0.0.1:{$PROWLARR_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    # Bazarr — base_url=/bazarr set in config.ini
    handle /bazarr* {
        reverse_proxy 127.0.0.1:{$BAZARR_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /deluge* {
        reverse_proxy 127.0.0.1:{$DELUGE_WEB_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    # Jellyseerr -- legacy alias only.  The app itself is served from the site root
    # (see the root routing at the end of this site block): it has no basePath support,
    # so serving it at "/" makes every absolute path it emits (/_next, /api, /login,
    # /movie/...) resolve without any per-route rules.  This prefix is kept so existing
    # /jellyseerr bookmarks and URLs printed by older installs keep working; the prefix
    # is stripped before proxying, exactly as before.
    handle_path /jellyseerr* {
        reverse_proxy 127.0.0.1:{$JELLYSEERR_PORT} {
            header_up X-Real-IP {remote_host}
        }
    }

    # Jellyfin — BaseUrl=/jellyfin set in network.xml
    handle /jellyfin* {
        reverse_proxy 127.0.0.1:{$JELLYFIN_PORT} {
            header_up X-Real-IP {remote_host}
            header_down -X-Frame-Options
        }
    }

    {$LLM_BLOCK}

    # Root routing is rendered by scripts/01_webserver.ps1 -- see $RootBlock there:
    # with Jellyseerr enabled it owns "/" (no basePath support) and the dashboard is
    # served from /dashboard; without Jellyseerr the dashboard keeps "/" so the root
    # is never a dead end.
    {$ROOT_BLOCK}
}
