    "OpenSubtitles": {
      "Username": "",
      "Password": ""
    },
    "Bazarr": {
      "TitloviUsername": "",
      "TitloviPassword": "",
      "SubdlApiKey": ""
    },
    "Jellyfin": {
      "GPU": "nvidia_ada",
      "MediaLibraries": [
        {
          "Name": "Movies",
          "Path": "C:\\MediaServer\\Media\\Movies",
          "Type": "movies"
        },
        {
          "Name": "TV Shows",
          "Path": "C:\\MediaServer\\Media\\TV",
          "Type": "tvshows"
        },
        {
          "Name": "RD Movies",
          "Path": "R:\\",
          "Type": "movies",
          "Lean": {
            "DisableVideoExtraction": true,
            "DisableMetadata": false,
            "DisableImages": false
          }
        }
      ]
