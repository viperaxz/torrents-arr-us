{
  "General": {
    "DomainMode": "cloudflare",
    "TlsMode": "letsencrypt",
    "TlsEmail": "your@email.com",
    "DebugLogging": false,

    "Domain": "example.com",
    "CloudflareApiToken": "your-cloudflare-api-token",

    "DuckDnsDomain": "myhome.duckdns.org",
    "DuckDnsToken": "your-duckdns-token",

    "AdminUsername": "admin",
    "AdminPassword": "SuperSecretPassword123!",
    "ServiceAccountPassword": "Svc@Seedbox2024!",
    "DefaultUserPassword": "UserPass123!",
    "InstallDir": "C:\\MediaServer"
  },
  "Apps": {
    "Jellyfin": true,
    "Sonarr": true,
    "Radarr": true,
    "Prowlarr": true,
    "Deluge": true,
    "Ffmpeg": true,
    "Bazarr": true,
    "Flaresolverr": true,
    "Jellyseerr": true,
    "Grafana": false,
    "RealDebrid": false
  },
  "RealDebrid": {
    "ApiKey": "",
    "MountLetter": "R"
  },
  "LLM": {
    "Enabled": false,
    "Subdomain": "llm",
    "BackendHost": "127.0.0.1",
    "BackendPort": 8081,
    "ApiKey": "",
    "ExposeUi": true
  },
  "Ports": {
    "Jellyfin": 8096,
    "Sonarr": 8989,
    "Radarr": 7878,
    "Prowlarr": 9696,
    "Deluge": 58846,
    "DelugeWeb": 8112,
    "DelugeBT": 56881,
    "Bazarr": 6767,
    "Flaresolverr": 8191,
    "Jellyseerr": 5055
  },
  "Paths": {
    "Downloads": "C:\\MediaServer\\Downloads",
    "Movies": "C:\\MediaServer\\Media\\Movies",
    "TV": "C:\\MediaServer\\Media\\TV"
  },
  "Security": {
    "CrowdSecEnrollKey": "",
    "BanDurationHours": 4,
    "ExtraWhitelistIps": [],
    "AbuseBlocklists": true
  },
  "Users": [
    { "Username": "alice", "Password": "" },
    { "Username": "bob",   "Password": "" }
  ],
  "Layer2": {
    "MinimumSeeders": 1,
    "PublicTrackerSeedRatio": 1.0,
    "Sonarr": {
      "DownloadClients": [
        {
          "Name": "Deluge",
          "Type": "Deluge",
          "Host": "127.0.0.1",
          "Port": 8112,
          "Priority": 1
        }
      ],
      "RootFolders": [
        {
          "Path": "C:\\MediaServer\\Media\\TV"
        }
      ]
    },
    "Radarr": {
      "DownloadClients": [
        {
          "Name": "Deluge",
          "Type": "Deluge",
          "Host": "127.0.0.1",
          "Port": 8112,
          "Priority": 1
        }
      ],
      "RootFolders": [
        {
          "Path": "C:\\MediaServer\\Media\\Movies"
        }
      ]
    },
    "Prowlarr": {
      "Indexers": [
        { "Name": "1337x",              "DefinitionName": "1337x",              "Enabled": true, "FlareSolverr": true },
        { "Name": "Bangumi Moe",        "DefinitionName": "bangumi-moe",        "Enabled": true, "FlareSolverr": true },
        { "Name": "BigFANGroup",        "DefinitionName": "bigfangroup",        "Enabled": true, "FlareSolverr": true },
        { "Name": "dmhy",               "DefinitionName": "dmhy",               "Enabled": true, "FlareSolverr": true },
        { "Name": "ExtraTorrent.st",    "DefinitionName": "extratorrent-st",    "Enabled": true, "FlareSolverr": true },
        { "Name": "Internet Archive",   "DefinitionName": "internetarchive",    "Enabled": true, "FlareSolverr": true },
        { "Name": "kickasstorrents.to", "DefinitionName": "kickasstorrents-to", "Enabled": true, "FlareSolverr": true },
        { "Name": "kickasstorrents.ws", "DefinitionName": "kickasstorrents-ws", "Enabled": true, "FlareSolverr": true },
        { "Name": "Knaben",             "DefinitionName": "Knaben",             "Enabled": true, "FlareSolverr": true },
        { "Name": "LimeTorrents",       "DefinitionName": "limetorrents",       "Enabled": true, "FlareSolverr": true },
        { "Name": "Magnet Cat",         "DefinitionName": "magnetcat",          "Enabled": true, "FlareSolverr": true },
        { "Name": "MegaPeer",           "DefinitionName": "megapeer",           "Enabled": true, "FlareSolverr": true },
        { "Name": "nekoBT",             "DefinitionName": "nekobt",             "Enabled": true, "FlareSolverr": true },
        { "Name": "NoNaMe Club",        "DefinitionName": "noname-club",        "Enabled": true, "FlareSolverr": true },
        { "Name": "Nyaa.si",            "DefinitionName": "nyaasi",             "Enabled": true, "FlareSolverr": true },
        { "Name": "The Pirate Bay",     "DefinitionName": "thepiratebay",       "Enabled": true, "FlareSolverr": true },
        { "Name": "Postman",            "DefinitionName": "postman",            "Enabled": true, "FlareSolverr": true },
        { "Name": "RuTor",              "DefinitionName": "rutor",              "Enabled": true, "FlareSolverr": true },
        { "Name": "SubsPlease",         "DefinitionName": "SubsPlease",         "Enabled": true, "FlareSolverr": true },
        { "Name": "Torrent Downloads",  "DefinitionName": "torrentdownloads",   "Enabled": true, "FlareSolverr": true },
        { "Name": "Torrent9",           "DefinitionName": "torrent9",           "Enabled": true, "FlareSolverr": true },
        { "Name": "TorrentByte",        "DefinitionName": "torrentbyte",        "Enabled": true, "FlareSolverr": true },
        { "Name": "Torrent[CORE]",      "DefinitionName": "torrentcore",        "Enabled": true, "FlareSolverr": true },
        { "Name": "TorrentDownload",    "DefinitionName": "torrentdownload",    "Enabled": true, "FlareSolverr": true },
        { "Name": "Torrentsome",        "DefinitionName": "torrentsome",        "Enabled": true, "FlareSolverr": true },
        { "Name": "Torrenttip",         "DefinitionName": "torrenttip",         "Enabled": true, "FlareSolverr": true },
        { "Name": "Uindex",             "DefinitionName": "uindex",             "Enabled": true, "FlareSolverr": true },
        { "Name": "World-torrent",      "DefinitionName": "world-torrent",      "Enabled": true, "FlareSolverr": true },
        { "Name": "Zamunda LIFE",       "DefinitionName": "zamundalife",        "Enabled": true, "FlareSolverr": true },
        {
          "Name": "RuTracker",
          "DefinitionName": "RuTracker.org",
          "Enabled": false,
          "Credentials": { "Username": "", "Password": "" },
          "SeedRules": { "Ratio": 1.0, "SeedTimeMinutes": 4320 }
        },
        {
          "Name": "FileList",
          "DefinitionName": "FileList.io",
          "Enabled": false,
